# Frontend env vars are bundled into the browser app.
# Only put public values here. Never store secrets in VITE_* variables.
#
# URL of your deployed backend API
# Local dev:   leave blank (vite proxy handles /api -> localhost:5001)
# Production:  https://movie-reviews-inky.vercel.app/api
VITE_API_BASE_URL=

# Local dev proxy target for the backend API.
# Change this if your backend uses a different local port.
VITE_DEV_PROXY_TARGET=http://localhost:5001
